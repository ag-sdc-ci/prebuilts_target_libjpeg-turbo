prefix=/apex/org.blisslabs.ag.libjpeg.turbo.dev
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}.dev/include

Name: libturbojpeg
Description: A SIMD-accelerated JPEG codec that provides the TurboJPEG API
Version: 2.1.0
Libs: -L${libdir} -L${prefix}.dev/lib -lturbojpeg
Cflags: -I${includedir}
